<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fanshuaiko.backage.dao.TeacherDao">
  <resultMap id="BaseResultMap" type="com.fanshuaiko.backage.entity.Teacher">
    <id column="id" property="id" jdbcType="BIGINT" />
    <result column="teacher_no" property="teacherNo" />
    <result column="name" property="name" />
    <result column="phone" property="phone" />
    <result column="email" property="email" />
    <result column="avatar_blob" property="avatarBlob" jdbcType="BLOB" />
    <result column="avatar_name" property="avatarName" />
    <result column="avatar_mime" property="avatarMime" />
    <result column="teach_class_scope" property="teachClassScope" jdbcType="VARCHAR" />
  </resultMap>

  <select id="selectByTeacherNo" parameterType="string" resultMap="BaseResultMap">
    select * from teacher where teacher_no = #{teacherNo}
  </select>

  <update id="updateAvatarByTeacherNo" parameterType="map">
    update teacher set avatar_blob = #{avatarBlob,jdbcType=BLOB}, avatar_name = #{avatarName}, avatar_mime = #{avatarMime} where teacher_no = #{teacherNo}
  </update>
</mapper>
